# Copy this file to `.env` and adjust. Real environment variables take precedence over the file.
# The npm scripts (dev:server, start) load `.env` automatically; every value is validated at start-up.

# development | production | test. In production error responses hide stack traces and internal details.
NODE_ENV=development

# Address the API listens on. 127.0.0.1 keeps it reachable from this computer only.
HOST=127.0.0.1
PORT=3001

# Folder for settings, backups, the operations journal, staged uploads and your own console profiles (devices/)
# (default: ~/.retro-game-manager; the data of older versions in ~/.game-manager or ~/.sf3000-manager is moved there on the first start).
# DATA_DIR=/path/to/data

# Origin(s) of the web client allowed to call the API cross-origin (comma-separated).
# The Angular dev server (npm run dev) runs on http://localhost:5173.
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Limits
# Maximum size of a JSON request body (the CSV editor sends the whole table), e.g. 25mb.
JSON_BODY_LIMIT=25mb
# Maximum size of an uploaded cover image, in bytes (default: 20 MiB).
MAX_IMAGE_BYTES=20971520
# Maximum size of an uploaded game file, in bytes (default: 4 GiB - 1, the FAT32 file size limit).
MAX_GAME_UPLOAD_BYTES=4294967295
# How long an uploaded file waits in the staging folder before it is swept away, in minutes.
UPLOAD_TTL_MINUTES=60
# Set by the desktop (Electron) app only: 1 turns on starting games in an emulator. Leave unset for the web version.
# GAME_MANAGER_DESKTOP=1

# Application version for the update check. Set by the desktop shell from app.getVersion(); without it the
# version of package.json is used.
# APP_VERSION=1.0.0
