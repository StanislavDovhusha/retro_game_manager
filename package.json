{
  "name": "retro-game-manager",
  "version": "1.0.0",
  "homepage": "https://github.com/StanislavDovhusha/retro_game_manager",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StanislavDovhusha/retro_game_manager.git"
  },
  "bugs": {
    "url": "https://github.com/StanislavDovhusha/retro_game_manager/issues"
  },
  "description": "Game library manager for the SD cards of retro handheld consoles: games, covers, tags and saves",
  "type": "module",
  "main": "build/electron/main.js",
  "private": true,
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "postinstall": "npm install --prefix client",
    "dev": "npm run build:main && concurrently -k -n renderer,main,electron -c magenta,blue,green \"npm:dev:renderer\" \"npm:dev:main\" \"npm:dev:electron\"",
    "dev:renderer": "npm run start --prefix client",
    "dev:main": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "dev:electron": "wait-on http-get://localhost:5173 && cross-env ELECTRON_RUN_AS_NODE= ELECTRON_RENDERER_URL=http://localhost:5173 electron .",
    "dev:browser": "concurrently -k -n server,client -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --env-file-if-exists=.env --watch src/server.ts",
    "dev:client": "npm run start --prefix client",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:server": "tsc -p tsconfig.build.json",
    "build:main": "npm run build:server",
    "build:client": "npm run build --prefix client",
    "build": "npm run build:server && npm run build:client",
    "build:app": "npm run build",
    "build:win": "npm run build:app && electron-builder --win --x64 --publish never",
    "build:mac": "npm run build:app && electron-builder --mac --x64 --arm64 --publish never",
    "build:linux": "npm run build:app && electron-builder --linux --x64 --publish never",
    "build:all": "npm run build:app && electron-builder --win --mac --linux --x64 --publish never",
    "icons": "python3 scripts/generate-icons.py && node scripts/build-mac-icon.ts",
    "start": "cross-env NODE_ENV=production node --env-file-if-exists=.env build/src/server.js",
    "preview": "npm run build && npm run start",
    "test": "node --test \"tests/**/*.test.ts\"",
    "test:unit": "node --test \"tests/unit/**/*.test.ts\"",
    "test:integration": "node --test \"tests/integration/**/*.test.ts\""
  },
  "dependencies": {
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "csv-parse": "^5.5.6",
    "csv-stringify": "^6.5.1",
    "express": "^4.19.2",
    "helmet": "^8.1.0",
    "iconv-lite": "^0.6.3",
    "pino": "^9.14.0",
    "semver": "7.7.2",
    "sharp": "^0.35.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.18.0",
    "@types/semver": "7.7.0",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "wait-on": "^8.0.0"
  },
  "productName": "Retro Game Manager",
  "author": "Dovhusha Stanislav",
  "license": "GPL-3.0-or-later"
}
